# School Hub environment variables. Copy to .env.local for local dev.
# NEVER commit real values. In production set these in Vercel → Settings → Environment Variables.

# --- Required ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=            # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Supabase "anon" / publishable key (public by design)
SUPABASE_SERVICE_ROLE_KEY=           # SECRET. Server only (webhooks, cron, encrypted tokens)
APP_URL=                             # https://your-app.vercel.app (no trailing slash)
TOKEN_ENCRYPTION_KEY=                # SECRET. `openssl rand -base64 32` — encrypts Gmail tokens
CRON_SECRET=                         # SECRET. `openssl rand -hex 24` — Vercel Cron sends it automatically

# --- AI extraction (required for real use) ----------------------------------
ANTHROPIC_API_KEY=                   # SECRET. console.anthropic.com → API keys
# AI_MODEL=claude-opus-5-5           # default
# AI_EFFORT=medium                   # low | medium | high

# --- Email (invites + morning digest). Any SMTP provider, e.g. Resend ------
SMTP_URL=                            # SECRET. smtps://resend:<api-key>@smtp.resend.com:465
EMAIL_FROM=School Hub <hello@yourdomain.com>

# --- Gmail integration (optional) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                # SECRET

# --- SMS forwarding via Twilio (optional) -----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                   # SECRET
TWILIO_PHONE_NUMBER=                 # +1XXXXXXXXXX

# --- Local testing only -----------------------------------------------------
# SCHOOLHUB_TEST_MODE=1              # AI stub for automated tests. Refused on Vercel production.
