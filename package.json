{
  "name": "school-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/m1-family.mjs && node tests/e2e/m2-extraction.mjs && node tests/e2e/m3-m5.mjs && node tests/e2e/onboarding-chat.mjs && node tests/e2e/points.mjs",
    "db:start": "supabase start -x realtime,edge-runtime,logflare,vector,supavisor,studio,postgres-meta,imgproxy",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "typecheck": "tsc --noEmit",
    "db:setup-sql": "for f in supabase/migrations/*.sql; do cat \"$f\"; echo; done > supabase/setup.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "15.5.29",
    "nodemailer": "^10.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
